-- Companies table for business entities that can own multiple salons
CREATE TABLE IF NOT EXISTS companies (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    owner_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    ico VARCHAR(20), -- IČO - Company ID number
    dic VARCHAR(20), -- DIČ - Tax ID
    ic_dph VARCHAR(25), -- IČ DPH - VAT number
    address TEXT,
    city VARCHAR(100),
    postal_code VARCHAR(10),
    country VARCHAR(50) DEFAULT 'Slovensko',
    email VARCHAR(255),
    phone VARCHAR(50),
    bank_account VARCHAR(50), -- IBAN
    created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc', NOW()),
    updated_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc', NOW())
);

-- Add company_id to salons table
ALTER TABLE salons ADD COLUMN IF NOT EXISTS company_id UUID REFERENCES companies(id) ON DELETE SET NULL;

-- Add visible IDs for easier support
ALTER TABLE salons ADD COLUMN IF NOT EXISTS display_id SERIAL;
ALTER TABLE companies ADD COLUMN IF NOT EXISTS display_id SERIAL;

-- Create index for faster lookups
CREATE INDEX IF NOT EXISTS idx_companies_owner_id ON companies(owner_id);
CREATE INDEX IF NOT EXISTS idx_salons_company_id ON salons(company_id);
CREATE INDEX IF NOT EXISTS idx_salons_display_id ON salons(display_id);
CREATE INDEX IF NOT EXISTS idx_companies_display_id ON companies(display_id);

-- Row Level Security
ALTER TABLE companies ENABLE ROW LEVEL SECURITY;

-- Users can view their own companies
CREATE POLICY "Users can view own companies" ON companies
    FOR SELECT USING (auth.uid() = owner_id);

-- Users can insert their own companies
CREATE POLICY "Users can insert own companies" ON companies
    FOR INSERT WITH CHECK (auth.uid() = owner_id);

-- Users can update their own companies
CREATE POLICY "Users can update own companies" ON companies
    FOR UPDATE USING (auth.uid() = owner_id);

-- Users can delete their own companies
CREATE POLICY "Users can delete own companies" ON companies
    FOR DELETE USING (auth.uid() = owner_id);

-- Grant admin full access (assumes admin role check)
CREATE POLICY "Admins can do everything on companies" ON companies
    FOR ALL USING (
        EXISTS (
            SELECT 1 FROM profiles
            WHERE profiles.id = auth.uid()
            AND profiles.role = 'admin'
        )
    );
